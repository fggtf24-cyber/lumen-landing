# В этой папке лежат только загруженные картинки. Любой скрипт здесь —
# признак взлома, поэтому выполнение запрещено, а отдаём только картинки.
<FilesMatch "\.(php|phtml|php[0-9]|phar|phps|cgi|pl|py|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# На случай, если PHP подключён как обработчик по расширению.
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
AddType text/plain .php .phtml .phar
